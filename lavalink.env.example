# Copy to lavalink.env.
# Leave both lines commented for the first start. Lavalink will log a sign-in URL and code.
# After you sign in with the SPARE Google account, Lavalink logs a refresh token.
# Paste it below, uncomment both lines, and restart: docker compose restart lavalink

# PLUGINS_YOUTUBE_OAUTH_REFRESHTOKEN=paste-refresh-token-here
# PLUGINS_YOUTUBE_OAUTH_SKIPINITIALIZATION=true
